# AI-CustomerHunter Ortam Degiskenleri Ornegi
# Bu dosyayi .env olarak kopyalayip degerleri doldurun.
# Panelden (/yonetim) kaydedilen ayarlar data/settings.json dosyasinda tutulur ve .env'den onceliklidir.

PORT=3090
DATA_DIR=./data
PUBLIC_URL=http://localhost:3090
TZ=Europe/Istanbul

# Oturum imzalama anahtari (bos birakilirsa DATA_DIR/secret.key otomatik uretilir)
SECRET_KEY=
SESSION_HOURS=12

# Ilk yerel yonetici hesabi (hic kullanici yoksa olusturulur; ADMIN_PASSWORD bossa DATA_DIR/ilk-yonetici.txt yazilir)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Virgulle ayrilmis yonetici Google e-posta adresleri (dogrudan aktif yonetici olarak acilir)
ADMIN_EMAILS=

# Google OAuth 2.0 (PKCE + OIDC)
# Yonlendirme adresi: ${PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-posta (SMTP — onay/ret bildirimleri)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAILS=

# Yapay Zeka / Ceviri API (istege bagli; bos birakilirsa ucretsiz MyMemory API kullanilir)
# AI_PROVIDER: none | anthropic | openai | gemini
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# MyMemory gunluk 50.000 karakter kotasi icin gecerli e-posta (istege bagli)
MYMEMORY_EMAIL=
